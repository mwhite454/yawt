# GitHub OAuth Configuration
# Create a GitHub OAuth App at: https://github.com/settings/developers
# For local development, use:
# - Application name: YAWT (local)
# - Homepage URL: http://localhost:8000
# - Authorization callback URL: http://localhost:8000/auth/callback
#
# For production, add an additional callback URL in your GitHub OAuth App settings.
# The app auto-detects the correct callback URL from the request, so you can use
# the same OAuth app for both local and production environments.
#
# Note: We use OAUTH_* prefix because GITHUB_* is reserved by GitHub Actions/Deploy

OAUTH_CLIENT_ID=your_oauth_client_id_here
OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# Canonical origin for www-redirect enforcement.
# All non-www (or otherwise non-canonical) traffic is 308-redirected to this origin.
# Set to your production www URL. Leave unset for local development.
# CANONICAL_ORIGIN=https://www.7syllable.com

# Optional: Override auto-detected redirect URI (usually not needed)
# OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Cloudflare R2 (S3-compatible)
# Required to enable presigned uploads for character images.
CLOUDFLARE_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
CLOUDFLARE_S3_ACCESS_KEY_ID=
CLOUDFLARE_S3_SECRET=
CLOUDFLARE_S3_BUCKET=

# Optional aliases for R2 configuration
# CLOUDFLARE_R2_BUCKET= (alias for CLOUDFLARE_S3_BUCKET)
# R2_ENDPOINT= (alias for CLOUDFLARE_S3_ENDPOINT)
# R2_ACCESS_KEY_ID= (alias for CLOUDFLARE_S3_ACCESS_KEY_ID)
# R2_SECRET_ACCESS_KEY= (alias for CLOUDFLARE_S3_SECRET)
